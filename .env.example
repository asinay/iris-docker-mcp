# Copy this file to .env and fill in real values. Never commit .env.
#
# iris-agentic-dev talks to IRIS over the Atelier REST API (the same API the
# VS Code ObjectScript extension uses) — this is the IRIS *web* port, not the
# superserver port (1972).
#
# Port reference (see docs/windows-setup.md):
#   IRIS 2024.1+ on Windows (IIS)   -> 80
#   IRIS 2024.1+ on Linux (Apache)  -> 80
#   Pre-2024.1 (any OS, PWS)        -> 52773

# --- Connection -------------------------------------------------------------

# Host running IRIS. Use host.docker.internal when IRIS runs natively on the
# Windows/macOS host. Use the container name or a DNS name for IRIS running
# in another container or on a remote host.
IRIS_HOST=host.docker.internal
IRIS_WEB_PORT=52773
IRIS_SCHEME=http
IRIS_NAMESPACE=USER
IRIS_USERNAME=_SYSTEM
IRIS_PASSWORD=change-me

# Only needed if your web gateway serves IRIS under a sub-path (e.g. HealthShare).
# IRIS_WEB_PREFIX=

# --- Security gates (see docs/security.md) ----------------------------------
#
# IMPORTANT: if left unset, iris-agentic-dev *infers* write_tools_enabled from
# your namespace name (namespaces that don't look like "prod" default to
# enabled). Do not rely on that inference — set these explicitly.

# 0 = disable every write-capable tool (safe default for this project)
IRIS_WRITE_TOOLS_ENABLED=0
# 0 = disable the 7 destructive tools even if writes are enabled (default is
# already 0/false and never inferred, but set it explicitly for clarity)
IRIS_DESTRUCTIVE_TOOLS_ENABLED=0

# Optional: least-privilege IRIS account used only for iris_execute,
# iris_execute_method, iris_query(mode=write), and iris_global(set/kill).
# IRIS_SERVICE_USERNAME=
# IRIS_SERVICE_PASSWORD=

# Optional: comma-separated allowlist of exact tool names to expose (further
# trims the surface beyond the write/destructive gates and any policy TOML).
# IRIS_ENABLED_TOOLS=iris_query,iris_search,iris_symbols,check_config

# Optional: baseline | nostub | merged (default: merged)
# IRIS_TOOLSET=merged

# Optional: drop skill/learning-agent tools entirely
# IRIS_NO_SKILLS=true
